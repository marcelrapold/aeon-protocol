{
  "name": "aeon-protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Validation toolchain for the ÆON Protocol specification repository.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node tools/validate.mjs",
    "validate:schemas": "node tools/validate.mjs schemas",
    "validate:links": "node tools/validate.mjs links",
    "validate:refs": "node tools/validate.mjs refs",
    "validate:yaml": "node tools/validate.mjs yaml",
    "validate:requirements": "node tools/validate.mjs requirements",
    "test": "node --test \"tools/**/*.test.mjs\""
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.0"
  }
}
